<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="co.edu.uniquindio.poo.panaderia.viewController.CancelarPedidoViewController"
           prefWidth="800" prefHeight="600"
           style="-fx-background-color: #2f2f2f;">
    <VBox alignment="CENTER" spacing="18" maxWidth="460" maxHeight="360"
          style="-fx-background-color: rgba(30,30,30,0.88); -fx-background-radius: 16; -fx-border-color: #e8c99b; -fx-border-radius: 16; -fx-border-width: 1.5;">
        <padding>
            <Insets top="32" right="36" bottom="32" left="36"/>
        </padding>
        <Label text="Cancelar pedido"
               style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #f5e6cc;"/>
        <Label text="Ingrese el código del pedido que desea cancelar"
               style="-fx-font-size: 14px; -fx-text-fill: #cfcfcf;"/>

        <TextField fx:id="txtCodigo" promptText="Código del pedido (ej. P01)"/>

        <Label fx:id="lblResultado" wrapText="true"
               style="-fx-text-fill: #f5e6cc; -fx-font-size: 13px;"/>

        <HBox spacing="12" alignment="CENTER">
            <Button fx:id="btnCancelar" text="Cancelar pedido" onAction="#cancelar"
                    style="-fx-background-color: #e8c99b; -fx-text-fill: #2f2f2f; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 10;"/>
            <Button fx:id="btnVolver" text="Volver" onAction="#volver"
                    style="-fx-background-color: transparent; -fx-text-fill: #e8c99b; -fx-border-color: #e8c99b; -fx-border-radius: 10; -fx-background-radius: 10;"/>
        </HBox>
    </VBox>
</StackPane>