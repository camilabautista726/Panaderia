<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="co.edu.uniquindio.poo.panaderia.viewController.RegistrarPedidoViewController"
           prefWidth="800" prefHeight="600"
           style="-fx-background-color: #2f2f2f;">
    <VBox alignment="CENTER" spacing="18" maxWidth="460" maxHeight="480"
          style="-fx-background-color: rgba(30,30,30,0.88); -fx-background-radius: 16; -fx-border-color: #e8c99b; -fx-border-radius: 16; -fx-border-width: 1.5;">
        <padding>
            <Insets top="32" right="36" bottom="32" left="36"/>
        </padding>
        <Label text="Registrar pedido"
               style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #f5e6cc;"/>

        <GridPane hgap="14" vgap="14">
            <Label text="Código" style="-fx-text-fill: #f5e6cc; -fx-font-size: 13px;"
                   GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txtCodigo" promptText="P01"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Cliente" style="-fx-text-fill: #f5e6cc; -fx-font-size: 13px;"
                   GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="txtCliente" promptText="Nombre del cliente"
                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Tipo de pan" style="-fx-text-fill: #f5e6cc; -fx-font-size: 13px;"
                   GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cmbTipoPan" promptText="Seleccione" maxWidth="Infinity"
                      GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Cantidad" style="-fx-text-fill: #f5e6cc; -fx-font-size: 13px;"
                   GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <Spinner fx:id="spnCantidad" min="0" max="100000" initialValue="1" editable="true"
                     maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        </GridPane>

        <Label fx:id="lblMensaje" wrapText="true"
               style="-fx-text-fill: #f5e6cc; -fx-font-size: 13px;"/>

        <HBox spacing="12" alignment="CENTER">
            <Button fx:id="btnRegistrar" text="Registrar" onAction="#registrar"
                    style="-fx-background-color: #e8c99b; -fx-text-fill: #2f2f2f; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 10;"/>
            <Button fx:id="btnVolver" text="Volver" onAction="#volver"
                    style="-fx-background-color: transparent; -fx-text-fill: #e8c99b; -fx-border-color: #e8c99b; -fx-border-radius: 10; -fx-background-radius: 10;"/>
        </HBox>
    </VBox>
</StackPane>
